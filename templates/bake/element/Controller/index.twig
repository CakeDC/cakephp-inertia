    /**
     * Index method VUE
     *
     * @return \Cake\Http\Response|null|void Renders view
     */
    public function index()
    {
{% set belongsTo = Bake.aliasExtractor(modelObj, 'BelongsTo') %}

        $sort = 'id';
        $direction = 'asc';
        $queryParams = $this->request->getQueryParams();
        if (array_key_exists('sort', $queryParams)) {
            $sort = $queryParams['sort'];
        }
        if (array_key_exists('direction', $queryParams)) {
            $direction = $queryParams['direction'];
        }

        $paginator = new NumericPaginator();
        ${{ pluralName }} = $paginator->paginate(
            $this->fetchTable('{{ currentModelName }}'),
            ['sort' => $sort, 'direction' => $direction],
            [
                'limit' => 1,
                'finder' => 'withRelated',
            ]
        );

        $links = $this->buildPaginationLinks(
            ${{ pluralName }},
            $this->getRequest()->getParam('controller'),
            $this->getRequest()->getParam('action')
        );

        $this->set(compact('{{ pluralName }}', 'links', 'sort', 'direction'));
    }
