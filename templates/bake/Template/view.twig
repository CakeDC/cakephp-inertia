{%- set associations = {'BelongsTo': [], 'HasOne': [], 'HasMany': [], 'BelongsToMany': []}|merge(associations) %}
{%- set fieldsData = Bake.getViewFieldsData(fields, schema, associations) %}
{%- set associationFields = fieldsData.associationFields %}
{%- set groupedFields = fieldsData.groupedFields %}
{%- set pK = '$' ~ singularVar ~ '->' ~ primaryKey[0] %}
{%- if prefix == '' %}
    {%- set baseUrl = '/' %}
{%- else %}
    {%- set baseUrl = '/' ~ prefix|lower ~ '/' %}
{%- endif %}
<script setup>
import Layout from '@/Components/Layout.vue'
import { Link } from '@inertiajs/vue3'
import { onMounted, onUnmounted, ref } from 'vue'
import moment from 'moment'

const props = defineProps({
    csrfToken: String,
    {{singularVar}}: Array|Object,
})

function formatDate(date) {
    return moment(date).format("YYYY-MM-DD")
}

onMounted(() => {
    console.log('Component categories/add onMounted hook called')
})
</script>

<template>
    <Layout>

        {%- set vueLabel = "{{" ~ singularVar ~ "." ~  displayField ~ "}}" %}
        <h2 class="mt-3 mb-3">{{ vueLabel }}</h2>

        <div class="table-responsive">
            <table class="table">
                <tbody>
            {%- if groupedFields['string'] %}
                {%- for field in groupedFields['string'] %}
                    {%- if associationFields[field] is defined %}
                        {%- set details = associationFields[field] %}
                        <tr>
                            <th class="align-middle">{{ field|humanize }}</th>
                            <td class="align-middle">
                                {%- set vueVarParent = singularVar ~ "." ~  details.property %}
                                {%- set vueVar = "{{" ~ singularVar ~ "." ~ details.property ~ "." ~ details.displayField  ~ "}}" %}
                                {%- set vueVarIndex = singularVar ~ "." ~ details.property ~ "." ~ details.primaryKey[0] %}
                                <Link v-if="{{ vueVarParent }}" class="" :href="'{{ baseUrl }}{{ details.controller|lower }}/view/' + {{ vueVarIndex }}">{{ vueVar }}</Link>
                            </td>
                        </tr>
                    {%- else %}
                        <tr>
                            <th class="align-middle">{{ field|humanize }}</th>
                            {%- set vueValue = "{{" ~ singularVar ~ "." ~  field ~ "}}" %}
                            <td class="align-middle">{{ vueValue }}</td>
                        </tr>
                    {%- endif %}
                {%- endfor %}
            {%- endif %}
            {%- if groupedFields.number %}
                {%- for field in groupedFields.number %}
                    <tr>
                        <th class="align-middle">{{ field|humanize }}</th>
                        <td class="align-middle">
                            {%- set vueVar = "{{" ~ singularVar ~ "." ~ field ~ "}}" %}
                            {{ vueVar }}
                        </td>
                    </tr>
                {%- endfor %}
            {%- endif %}
            {%- if groupedFields.date %}
                {%- for field in groupedFields.date %}
                    <tr>
                        <th class="align-middle">{{ field|humanize }}</th>
                        <td class="align-middle">
                            {%- set vueVar = "{{ formatDate(" ~ singularVar ~ "." ~ field ~ ") }}" %}
                            {{ vueVar }}
                        </td>
                    </tr>
                {%- endfor %}
            {%- endif %}
                </tbody>
        </table>
        {%- if groupedFields.text %}
            {%- for field in groupedFields.text %}
                <div class="text">
                    <strong>{{ field|humanize }}</strong>
                    <blockquote>
                        {%- set vueVar = singularVar ~ "." ~ field %}
                        <span v-html="{{ vueVar }}"></span>
                    </blockquote>
                </div>
            {%- endfor %}
        {%- endif %}
        {%- set relations = associations.BelongsToMany|merge(associations.HasMany) %}
        {%- for alias, details in relations %}
            {%- set otherSingularVar = alias|variable %}
            {%- set otherPluralHumanName = details.controller|underscore|humanize %}
            <div class="related mt-5">
                <h4>{{ otherPluralHumanName }}</h4>
                <span v-if="{{ singularVar }}.{{ details.property }} && {{ singularVar }}.{{ details.property }}.length != 0">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                            <tr>
                                {%- for field in details.fields %}
                                    <th class="align-middle">{{ field|humanize }}</th>
                                {%- endfor %}
                                <th class="actions align-middle">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr v-for="{{ otherSingularVar }} in {{ singularVar }}.{{ details.property }}">
                                {%- for field in details.fields %}
                                    {%- set vueValue = "{{" ~ otherSingularVar ~ "." ~  field ~ "}}" %}
                                    <td class="align-middle">{{ vueValue }}</td>
                                {%- endfor %}
                                {%- set otherPk = otherSingularVar ~ '.' ~ details.primaryKey[0] %}
                                <td class="actions align-middle">
                                    <Link class="btn btn-sm btn-outline-info ms-1" as="button" :href="'{{ baseUrl }}{{ otherSingularVar }}/view/' + {{ otherPk }}">View</Link>
                                    <Link class="btn btn-sm btn-outline-warning ms-1" as="button" :href="'{{ baseUrl }}{{ otherSingularVar }}/edit/' + {{ otherPk }}">Edit</Link>
                                    <Link class="btn btn-sm btn-outline-danger ms-1" as="button" method="post" :href="'{{ baseUrl }}{{ otherSingularVar }}/delete/' + {{ otherPk }}">Delete</Link>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </span>
            </div>
        {%- endfor %}
        </div>

    </Layout>
</template>

