<script setup>
import { Link } from '@inertiajs/vue3'
import Layout from '@/Components/Layout.vue'
import { onMounted, onUnmounted, ref } from 'vue'
import moment from 'moment'

const props = defineProps({
    csrfToken: String,
    flash: Array|Object,
    {{ pluralVar }}: Array|Object,
    sort: String,
    direction: String,
    links: Array|Object,
})

const direction = ref(0)

const defaultClass = Object ({
    id: '',
    name: '',
})

function confirm(){
    return window.confirm("Are you sure?");
}

function formatDate(date) {
    return moment(date).format("YYYY-MM-DD")
}

function sortDirection(p) {
    let direction = 'asc';
    if (p === props.sort) {
        if (props.direction === 'desc') {
            direction = 'asc';
        } else {
            direction = 'desc';
        }
    }

    return direction;
}

onMounted(() => {
    console.log('Component {{ pluralVar }}/{{ action }} onMounted hook called')
})

</script>

<template>
    <Layout>
        {%- if prefix == '' %}
            {% set baseUrl = '/' %}
        {%- else %}
            {% set baseUrl = '/' ~ prefix|lower ~ '/' %}
        {%- endif %}

        {%- set vueVar = "{{ props.flash['message'] }}" %}{{- "\n" }}
        <div onclick="this.classList.add('d-none')" :class="[(props.flash['element'] === undefined) ? 'd-none' : '','alert', props.flash['element']]">
            {{ vueVar }}
        </div>

        <h2 class="mt-3 mb-3">{{ pluralHumanName }}</h2>

        <div class="row">
            <div class="col-2">{{- "\n" }}
                {%- if prefix == '' %}
                    <Link as="button" href="/{{ pluralVar }}/add" class="btn btn-outline-primary mb-3">Add {{ singularHumanName }}</Link>
                {%- else %}
                    <Link as="button" href="/{{ prefix|lower }}/{{ pluralVar }}/add" class="btn btn-outline-primary mb-3">Add {{ singularHumanName }}</Link>
                {%- endif %}
            {{- "\n" }}</div>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                <tr>
                    {%- for field in fields %}{{- "\n" }}
                    <th scope="col">
                        <Link href="{{ baseUrl }}{{ pluralVar }}/index" :class="defaultClass.{{ field }}" :data="{ sort: '{{ field }}', direction: sortDirection('{{ field }}') }">{{ field|capitalize }}</Link>
                    </th>
                    {%- endfor %}
                    {{- "\n" }}<th class="actions">Actions</th>
                </tr>
                </thead>
                <tbody>
                    <tr v-for="{{ singularVar }} in {{ pluralVar }}">
                        {%- for field in fields %}
                            {%- set isKey = false %}
                            {%- if associations.BelongsTo is defined %}
                                {%- for alias, details in associations.BelongsTo %}
                                    {%- if field == details.foreignKey %}
                                        {%- set isKey = true %}
                                        {%- set vueVarParent = singularVar ~ "." ~  details.property %}
                                        {%- set vueVar = "{{" ~ singularVar ~ "." ~ details.property ~ "." ~ details.displayField  ~ "}}" %}
                                        {%- set vueVarIndex = singularVar ~ "." ~ details.property ~ "." ~ details.primaryKey[0] %}
                        <td class="align-middle">
                            <span v-if="{{ vueVarParent }}">
                                <Link as="button" class="btn btn-sm btn-outline-info" :href="'{{ baseUrl }}{{ details.controller|lower }}/view/' + {{ vueVarIndex }}">{{ vueVar }}</Link>
                            </span>
                        </td>
                                    {%- endif %}
                                {%- endfor %}
                            {%- endif %}

                            {{- "\n" }}
                            {%- if isKey is not same as(true) %}
                                {%- set columnData = Bake.columnData(field, schema) %}
                                {%- if columnData.type not in ['integer', 'float', 'decimal', 'biginteger', 'smallinteger', 'tinyinteger', 'timestampfractional'] %}
                        <td class="align-middle">
                            {#  todo: need trucnate #}
                            {%- set vueVar = "{{" ~ singularVar ~ "." ~ field ~ "}}" %}
                            {{- vueVar }}
                        </td>
                                {%- elseif columnData.type == 'timestampfractional' %}
                        <td class="align-middle">
                            {%- set vueVar = "{{ formatDate(" ~ singularVar ~ "." ~ field ~ ") }}" %}
                            {{- vueVar }}</td>
                                {%- elseif columnData.null %}
                                    {#  todo: need check vueVar === null #}
                        <td class="align-middle">
                            {%- set vueVar = "{{" ~ singularVar ~ "." ~ field ~ "}}" %}
                            {{- vueVar }}
                        </td>
                                {%- else %}
                        <td class="align-middle">
                            {%- set vueVar = "{{" ~ singularVar ~ "." ~ field ~ "}}" %}
                            {{- vueVar }}</td>
                                {%- endif %}
                            {%- endif %}
                    {%- endfor %}
                        {{- "\n" }}
                        <td class="actions align-middle">
                            <Link class="btn btn-sm btn-outline-info ms-1" as="button" method="get" :href="'{{ baseUrl }}{{ pluralVar }}/view/' + {{ singularVar }}.id">View</Link>
                            <Link class="btn btn-sm btn-outline-warning ms-1" as="button" method="get" :href="'{{ baseUrl }}{{ pluralVar }}/edit/' + {{ singularVar }}.id">Edit</Link>
                            <Link class="btn btn-sm btn-outline-danger ms-1" as="button" method="delete" :headers="{'X-CSRF-Token': props.csrfToken}" :onBefore="() => confirm()" :href="'{{ baseUrl }}{{ pluralVar }}/delete/' + {{ singularVar }}.id">Delete</Link>
                        </td>
                    </tr>
               </tbody>
           </table>
        </div>

        <span v-if="links.length > 1">
           <nav>
               <ul class="pagination">
                   <template v-for="(link, key) in links">
                       <li class="page-item">
                           {% set vueLabel = "{{ link.label }}" %}
                            <Link as="button" :key="key" class="page-link" :href="link.url">{{ vueLabel }}</Link>
                       </li>
                   </template>
               </ul>
           </nav>
        </span>

    </Layout>
</template>